[Unit]
Description=Video Parser Node API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=video-parser
Group=video-parser
WorkingDirectory=/opt/video-parser/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/video-parser/server.env
ExecStart=/usr/bin/node /opt/video-parser/current/server/index.mjs
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=25s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/video-parser
RestrictSUIDSGID=yes
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=video-parser

[Install]
WantedBy=multi-user.target
