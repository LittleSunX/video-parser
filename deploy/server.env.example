# systemd EnvironmentFile；复制到 /etc/video-parser/server.env。
# Node 不会自动读取 .env；不要把 VITE_* 或 Cloudflare 凭据放在这里。
# 只在本机 loopback 监听，与同机 Nginx 模板配套，不要改为公网地址。
HOST=127.0.0.1
PORT=8787

# 应用默认 none。此模板显式信任同机 Nginx 覆盖后的 X-Real-IP。
# 仅可信 loopback socket 的 X-Real-IP 会被采纳；不读取其他转发链。
TRUST_PROXY=loopback

MAX_CONCURRENT_PARSES=8
MAX_CONCURRENT_DOWNLOADS=16
MAX_DOWNLOADS_PER_IP=4

# 毫秒；systemd TimeoutStopSec 必须更长，本模板服务单元为 25s。
SHUTDOWN_TIMEOUT_MS=15000
