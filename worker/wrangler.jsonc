{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "video-parser-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "PARSE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
